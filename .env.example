# Copy to .env.local and fill in. Nothing here is secret at runtime — a
# NEXT_PUBLIC_ value is inlined into the client bundle — but the repo is
# public, so the real number lives only in the untracked file.
NEXT_PUBLIC_WHATSAPP=

# Analytics. Both are optional: left empty, the tags are never rendered at all,
# so a fork or a preview deployment measures nobody. Neither loads until the
# reader accepts the consent banner regardless.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID, e.g. abcd1234ef
NEXT_PUBLIC_CLARITY_ID=

# Contact form. Without RESEND_API_KEY the endpoint returns a clear error and
# the form tells the reader to email directly, so a fork still builds and runs.
# Key from resend.com/api-keys
RESEND_API_KEY=
# Where enquiries land. Defaults to the address in content/data.ts.
CONTACT_TO=
# The verified sender. Resend's onboarding@resend.dev works for testing;
# a real domain has to be verified with them before it will send.
CONTACT_FROM=
